## 🛠️ ATA PIO Read (Assembly)

This reads one 512-byte sector from disk using LBA:

```asm
ata_read_sector:
    ; Input: LBA in EAX, buffer in ES:BX
    push dx
    push ax
    push cx

    ; Set sector count to 1
    mov dx, 0x1F2
    mov al, 1
    out dx, al

    ; Set LBA low/mid/high
    mov dx, 0x1F3
    out dx, al
    mov dx, 0x1F4
    mov al, ah
    out dx, al
    shr eax, 16
    mov dx, 0x1F5
    mov al, al
    out dx, al

    ; Drive/head register
    mov dx, 0x1F6
    mov al, 0xE0
    out dx, al

    ; Send READ SECTORS command
    mov dx, 0x1F7
    mov al, 0x20
    out dx, al

.wait_drq:
    in al, dx
    test al, 0x08
    jz .wait_drq

    ; Read 256 words (512 bytes)
    mov cx, 256
    mov dx, 0x1F0
.read_loop:
    in ax, dx
    stosw
    loop .read_loop

    pop cx
    pop ax
    pop dx
    ret
```

---

## 📦 FAT16 Reader (Assembly)

This reads the root directory and finds a file by name:

```asm
read_root_directory:
    ; Assume root dir starts at LBA 19 (for standard FAT16)
    mov eax, 19
    mov bx, buffer
    call ata_read_sector

    ; Scan for filename "TEST    TXT"
    mov si, buffer
.find_file:
    mov cx, 11
    mov di, filename
    repe cmpsb
    je .found
    add si, 21       ; Move to next entry
    cmp si, buffer+512
    jl .find_file
    ret

.found:
    ; Get starting cluster
    mov ax, [si+26]
    mov [file_cluster], ax
    ret

filename db 'TEST    TXT'
file_cluster dw 0
buffer times 512 db 0
```

---

## 🧪 Reading File Data

Once you have the starting cluster:
- Calculate the LBA: `LBA = DataStart + (cluster - 2) * sectors_per_cluster`
- Call `ata_read_sector` again to load the file data.

---

