## 🛠️ 1. Bootloader (Real Mode → Protected Mode)

```asm
; bootloader.asm
[org 0x7c00]
bits 16

start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax

    ; Load kernel from disk (assume 1 sector at 0x1000)
    mov ah, 0x02
    mov al, 1
    mov ch, 0
    mov cl, 2
    mov dh, 0
    mov dl, 0x80
    mov bx, 0x1000
    int 0x13

    ; Enter protected mode
    call enable_protected_mode

    ; Jump to kernel
    jmp 0x0008:0x1000

enable_protected_mode:
    ; Setup GDT
    lgdt [gdt_descriptor]

    ; Set PE bit in CR0
    mov eax, cr0
    or eax, 1
    mov cr0, eax

    ; Far jump to flush pipeline
    jmp 0x08:protected_mode_entry

gdt:
    dw 0x0000, 0x0000, 0x0000, 0x0000         ; Null
    dw 0xFFFF, 0x0000, 0x9A00, 0x00CF         ; Code
    dw 0xFFFF, 0x0000, 0x9200, 0x00CF         ; Data

gdt_descriptor:
    dw gdt_end - gdt - 1
    dd gdt

gdt_end:

protected_mode_entry:
    mov ax, 0x10
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax
    mov ss, ax
    mov esp, 0x90000

    jmp 0x1000

times 510 - ($ - $$) db 0
dw 0xAA55
```

