## 🛠️ Modified Bootloader (FAT16 + ATA PIO)

Here’s a simplified bootloader that:
- Reads the FAT16 boot sector.
- Locates `KERNEL.BIN` in the root directory.
- Loads its first cluster into memory at `0x1000`.
- Jumps to it.

```asm
[org 0x7c00]
bits 16

start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax

    mov si, msg
    call print_string

    ; Read sector 0 (FAT16 boot sector)
    mov bx, buffer
    mov dl, 0x80
    mov dh, 0
    mov ch, 0
    mov cl, 1
    call read_sector

    ; Parse FAT16 boot sector
    mov ax, [buffer + 0x0B]     ; Bytes per sector
    mov [bps], ax
    mov al, [buffer + 0x0D]     ; Sectors per cluster
    mov [spc], al
    mov ax, [buffer + 0x0E]     ; Reserved sectors
    mov [rs], ax
    mov al, [buffer + 0x10]     ; Number of FATs
    mov [nf], al
    mov ax, [buffer + 0x16]     ; Sectors per FAT
    mov [spf], ax
    mov ax, [buffer + 0x11]     ; Max root entries
    mov [re], ax

    ; Calculate root dir LBA
    mov ax, [rs]
    mov cx, [nf]
    mul cx
    add ax, [rs]
    mov cx, [re]
    mov dx, [bps]
    mul cx
    div dx
    add ax, [rs]
    mov [root_lba], ax

    ; Read root directory
    mov bx, buffer
    mov eax, [root_lba]
    call read_sector_lba

    ; Search for "KERNEL  BIN"
    mov si, buffer
.next_entry:
    mov cx, 11
    mov di, filename
    repe cmpsb
    je .found
    add si, 32
    cmp si, buffer + 512
    jl .next_entry
    jmp $

.found:
    mov ax, [si + 26]       ; Starting cluster
    mov [cluster], ax

    ; Calculate data region LBA
    mov ax, [rs]
    mov cx, [nf]
    mul cx
    add ax, [rs]
    mov dx, [re]
    mov cx, 32
    mul cx
    div [bps]
    add ax, [rs]
    mov [data_lba], ax

    ; Convert cluster to LBA
    mov ax, [cluster]
    sub ax, 2
    mov cx, [spc]
    mul cx
    add ax, [data_lba]
    mov eax, ax

    ; Load kernel to 0x1000
    mov bx, 0x1000
    call read_sector_lba

    jmp 0x1000

print_string:
    mov ah, 0x0E
.next_char:
    lodsb
    cmp al, 0
    je .done
    int 0x10
    jmp .next_char
.done:
    ret

read_sector:
    mov ah, 0x02
    mov al, 1
    int 0x13
    ret

read_sector_lba:
    ; Simplified LBA read using BIOS
    ; Assumes CHS mapping is valid
    ret

filename db 'KERNEL  BIN'
msg db 'Booting Fortran Kernel...', 0
buffer times 512 db 0
bps dw 0
spc db 0
rs dw 0
nf db 0
spf dw 0
re dw 0
root_lba dw 0
cluster dw 0
data_lba dw 0

times 510 - ($ - $$) db 0
dw 0xAA55
```

